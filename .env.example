# Copy to .env and fill. NEVER commit .env.
# Lead pipeline — set these in Cloudflare Pages → Settings → Environment variables
# (the /api/leads function reads them at runtime; not needed for local `astro dev`).
BREVO_API_KEY=                  # Brevo API v3 key (transactional email + contacts/automation)
LEADS_TO_EMAIL=                 # Inbox that receives new-lead alerts
LEADS_FROM_EMAIL=               # Verified Brevo sender, e.g. no-reply@daitinstitute.com
LEADS_FROM_NAME=DAIT Institute  # Sender display name (optional)
BREVO_LIST_ID=                  # Brevo list new leads join — the automation trigger (optional)
LEAD_WEBHOOK_URL=               # Optional — extra CRM / WhatsApp-BSP endpoint (e.g. AiSensy)

# Public (exposed to the browser — safe to ship):
PUBLIC_WHATSAPP_NUMBER=         # +91XXXXXXXXXX  (digits only for wa.me, no spaces)
PUBLIC_GTM_ID=                  # Google Tag Manager container (defaults to GTM-M2CXJCSP; GA4 lives inside it)
PUBLIC_GA4_ID=                  # G-XXXXXXX  (leave blank — GA4 is delivered via GTM)
PUBLIC_META_PIXEL_ID=           # Meta/Facebook Pixel ID (leave blank to disable; for Meta ads)
PUBLIC_SITE_URL=https://daitinstitute.com   # canonical URLs

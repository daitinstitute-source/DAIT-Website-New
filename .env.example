# Copy to .env and fill. NEVER commit .env.
# Lead pipeline — set these in Cloudflare Pages → Settings → Environment variables
# (the /api/leads function reads them at runtime; not needed for local `astro dev`).
BREVO_API_KEY=                  # Brevo API v3 key (transactional email + contacts/automation)
LEADS_TO_EMAIL=                 # Inbox that receives new-lead alerts
LEADS_FROM_EMAIL=               # Verified Brevo sender, e.g. no-reply@daitinstitute.com
LEADS_FROM_NAME=DAIT Institute  # Sender display name (optional)
BREVO_LIST_ID=                  # Brevo list new leads join — the automation trigger (optional)
BREVO_PIPELINE_ID=              # Brevo CRM pipeline for deals — run `npm run brevo:pipelines`
BREVO_STAGE_ID=                 # Stage new leads land in (usually "New") — same command
LEAD_WEBHOOK_URL=               # Optional — extra CRM / WhatsApp-BSP endpoint (e.g. AiSensy)

# Public (exposed to the browser — safe to ship):
PUBLIC_WHATSAPP_NUMBER=         # +91XXXXXXXXXX  (digits only for wa.me, no spaces)
PUBLIC_GTM_ID=                  # Google Tag Manager container (defaults to GTM-M2CXJCSP; GA4 lives inside it)
PUBLIC_GA4_ID=                  # G-XXXXXXX  (leave blank — GA4 is delivered via GTM)
PUBLIC_META_PIXEL_ID=           # Meta/Facebook Pixel ID (leave blank to disable; for Meta ads)
PUBLIC_SITE_URL=https://www.daitinstitute.com   # canonical URLs — MUST match the host the server serves (Vercel 308s the apex to www)

# Public certificate verification (/verify?c=CODE) — reads the portal's Supabase
# project through two SECURITY DEFINER RPCs that expose no attendee PII. The anon
# key is publishable by design; RLS keeps every underlying table staff-only.
PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=       # Supabase anon/publishable key (safe in the browser)

# Conversational chatbot (/api/chat). The knowledge pack is generated from the
# program and blog collections at build time — see scripts/build-chat-knowledge.mjs.
# A captured callback is filed through the SAME lead pipeline as every form, so
# the Brevo vars above are required for the bot to create a lead.
ANTHROPIC_API_KEY=              # Anthropic API key (server-side only, never PUBLIC_)
CHAT_MODEL=                     # Optional override; defaults to claude-opus-5-5
CHAT_ALLOWED_ORIGIN=            # Optional CSV, e.g. https://daitinstitute.com — unset allows any origin

# Brochure download gate. The PDFs live in assets/brochures/ (outside the web
# root) and /api/brochure serves them only against a signed token that
# /api/leads mints after a lead is filed — so there is no way to the file that
# does not leave a contact behind. Optional: falls back to BREVO_API_KEY, which
# is already set, so the gate works without this. Set it to use a dedicated key.
BROCHURE_SECRET=

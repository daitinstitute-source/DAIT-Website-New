---
/**
 * Header — sticky white/blur bar. Logo, desktop nav with Programs dropdown
 * (area list from navigation.ts), primary CTA, and a mobile menu.
 * Dropdown works without JS (focus-within/hover); mobile toggle is a tiny script.
 */
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config/site";
import {
  mainNav,
  programAreas,
  primaryCta,
} from "../../data/navigation";
import Button from "../ui/Button.astro";
import MobileNav from "./MobileNav.astro";

interface Props {
  solid?: boolean;
}
const { solid = true } = Astro.props;
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<header
  class:list={[
    "sticky top-0 z-40 border-b transition-colors",
    solid
      ? "bg-surface-75/95 backdrop-blur border-border"
      : "bg-transparent border-transparent",
  ]}
>
  <div class="container-wide flex items-center justify-between h-[88px] gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0" aria-label="DAIT Institute — home">
      <img
        src={siteConfig.logo.horizontalLight}
        alt="DAIT Institute — Digital AI & IT Training"
        width="769"
        height="324"
        class="h-14 sm:h-[68px] w-auto"
      />
    </a>

    <!-- Desktop nav (full menu at xl; logo links home so we drop the Home item) -->
    <nav class="hidden xl:flex items-center gap-0.5" aria-label="Primary">
      {
        mainNav
          .filter((item) => !item.comingSoon && item.href !== "/")
          .map((item) =>
            item.dropdown ? (
              <div class="relative group">
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-semibold transition-colors",
                    isActive(item.href)
                      ? "text-accent-600"
                      : "text-ink-500 hover:text-accent-600 hover:bg-accent-50",
                  ]}
                  aria-haspopup="true"
                >
                  {item.label}
                  <Icon
                    name="lucide:chevron-down"
                    size={15}
                    class="transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                  />
                </a>
                {/* Dropdown */}
                <div class="absolute left-0 top-full pt-2 w-[320px] opacity-0 invisible translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0">
                  <div class="card p-2">
                    {programAreas.map((area) => (
                      <a
                        href={`/programs/#${area.slug}`}
                        class="flex items-start gap-3 p-3 rounded-lg hover:bg-accent-50 transition-colors group/item"
                      >
                        <span class="shrink-0 mt-0.5 flex h-9 w-9 items-center justify-center rounded-lg bg-accent-50 text-accent-600 group-hover/item:bg-accent-500 group-hover/item:text-white transition-colors">
                          <Icon name={area.icon} size={18} />
                        </span>
                        <span>
                          <span class="block text-sm font-bold text-ink-900">
                            {area.label}
                          </span>
                          <span class="block text-xs text-ink-500 leading-snug mt-0.5">
                            {area.description}
                          </span>
                        </span>
                      </a>
                    ))}
                    <a
                      href="/programs/"
                      class="flex items-center justify-center gap-1 mt-1 p-2.5 rounded-lg text-sm font-bold text-accent-600 hover:bg-accent-50 transition-colors"
                    >
                      View all programs
                      <Icon name="lucide:arrow-right" size={15} />
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "px-2.5 py-2 rounded-lg text-sm font-semibold whitespace-nowrap transition-colors",
                  isActive(item.href)
                    ? "text-accent-600"
                    : "text-ink-500 hover:text-accent-600 hover:bg-accent-50",
                ]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ),
          )
      }
    </nav>

    <!-- CTA + mobile toggle -->
    <div class="flex items-center gap-2">
      <Button href={primaryCta.href} size="sm" iconLeft="lucide:phone-call" class="hidden sm:inline-flex">
        Free Counselling
      </Button>
      <button
        type="button"
        id="mobile-nav-toggle"
        class="xl:hidden inline-flex items-center justify-center h-10 w-10 rounded-lg text-ink-900 hover:bg-accent-50 focus-visible:outline-2 focus-visible:outline-accent-500"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="lucide:menu" size={24} />
      </button>
    </div>
  </div>
</header>

<MobileNav />

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav");
  const close = document.getElementById("mobile-nav-close");
  const open = () => {
    panel?.classList.remove("translate-x-full");
    panel?.setAttribute("aria-hidden", "false");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };
  const shut = () => {
    panel?.classList.add("translate-x-full");
    panel?.setAttribute("aria-hidden", "true");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };
  toggle?.addEventListener("click", open);
  close?.addEventListener("click", shut);
  panel?.addEventListener("click", (e) => {
    if (e.target === panel) shut();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") shut();
  });
</script>

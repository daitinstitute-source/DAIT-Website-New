---
/**
 * Footer — dark. Logo, tagline, program links (by area), quick links,
 * center address(es), phone/email/WhatsApp, social, hours.
 */
import { Icon } from "astro-icon/components";
import { siteConfig, whatsappLink } from "../../config/site";
import {
  programAreas,
  footerQuickLinks,
  studentLogin,
} from "../../data/navigation";

const year = new Date().getFullYear();
const waHref = whatsappLink();
const hasPhone = Boolean(siteConfig.phone);
---

<footer class="bg-dark-950 text-white/70">
  <div class="container-wide py-10 lg:py-12">
    <div class="grid gap-8 lg:gap-8 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.3fr]">
      <!-- Brand -->
      <div>
        <img
          src={siteConfig.logo.stackedDark}
          alt="DAIT Institute"
          height="72"
          width="150"
          class="h-16 w-auto mb-4"
        />
        <p class="text-sm leading-relaxed max-w-xs text-white/60">
          {siteConfig.legalName}. {siteConfig.tagline}.
        </p>
        <p class="mt-3 flex items-center gap-2 text-xs font-semibold text-white/70">
          <Icon name="lucide:landmark" size={14} class="text-orange-500" />
          A {siteConfig.group.name} initiative · Since {siteConfig.group.established}
        </p>
        <div class="flex items-center gap-3 mt-5">
          {
            siteConfig.social
              .filter((s) => s.href && s.href !== "#")
              .map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/10 hover:bg-orange-500 text-white transition-colors"
                >
                  <Icon name={s.icon} size={17} />
                </a>
              ))
          }
        </div>
      </div>

      <!-- Programs by area -->
      <nav aria-label="Programs">
        <h2 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">
          Programs
        </h2>
        <ul class="space-y-2.5 text-sm">
          {
            programAreas.map((area) => (
              <li>
                <a
                  href={`/programs/#${area.slug}`}
                  class="hover:text-white transition-colors"
                >
                  {area.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Quick links -->
      <nav aria-label="Quick links">
        <h2 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">
          Quick Links
        </h2>
        <ul class="space-y-2.5 text-sm">
          {
            footerQuickLinks.map((l) => (
              <li>
                <a href={l.href} class="hover:text-white transition-colors">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={studentLogin.href}
              class="inline-flex items-center gap-1.5 hover:text-white transition-colors text-white/50"
            >
              {studentLogin.label}
              <span class="text-[0.6rem] uppercase tracking-wide bg-white/10 px-1.5 py-0.5 rounded">
                Soon
              </span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Contact / centers -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">
          Visit / Contact
        </h2>
        {
          siteConfig.centers.map((center) => (
            <address class="not-italic text-sm space-y-2 mb-4">
              <p class="flex items-start gap-2.5">
                <Icon
                  name="lucide:map-pin"
                  size={16}
                  class="mt-0.5 shrink-0 text-orange-500"
                />
                <span>
                  {center.addressLines.join(", ")}
                  <br />
                  {center.city}, {center.state}
                  {center.postalCode ? ` ${center.postalCode}` : ""}
                </span>
              </p>
              {center.hours && (
                <p class="flex items-center gap-2.5 text-white/60">
                  <Icon name="lucide:clock" size={16} class="text-orange-500" />
                  {center.hours}
                </p>
              )}
            </address>
          ))
        }
        <ul class="space-y-2 text-sm">
          {
            hasPhone && (
              <li>
                <a
                  href={`tel:${siteConfig.phone.replace(/\s/g, "")}`}
                  class="flex items-center gap-2.5 hover:text-white"
                >
                  <Icon name="lucide:phone" size={16} class="text-orange-500" />
                  {siteConfig.phone}
                </a>
              </li>
            )
          }
          <li>
            <a
              href={`mailto:${siteConfig.email}`}
              class="flex items-center gap-2.5 hover:text-white"
            >
              <Icon name="lucide:mail" size={16} class="text-orange-500" />
              {siteConfig.email}
            </a>
          </li>
          {
            waHref && (
              <li>
                <a
                  href={waHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2.5 hover:text-white"
                >
                  <Icon
                    name="simple-icons:whatsapp"
                    size={16}
                    class="text-orange-500"
                  />
                  WhatsApp
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <!-- Sister institutions band -->
    <div class="mt-9 pt-6 border-t border-white/10">
      <p class="mb-3 text-xs font-bold uppercase tracking-wider text-white/40">
        Part of the {siteConfig.group.name}
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/55">
        {
          siteConfig.group.institutions.map((inst) => (
            <li>{inst.name}</li>
          ))
        }
        <li class="font-semibold text-white/80">DAIT Institute</li>
      </ul>
    </div>

    <div
      class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/40"
    >
      <p>© {year} {siteConfig.name}. All rights reserved.</p>
      <p>{siteConfig.legalName} · {siteConfig.centers[0].city}</p>
    </div>
  </div>
</footer>

---
/**
 * CookieConsent — bottom banner that gates analytics until the visitor chooses.
 *
 * Pairs with the consent gate in BaseLayout: Google/Meta tags are NOT injected
 * until `window.daitConsent.set("granted")` runs. Choosing "Essential only"
 * stores a refusal, clears our first-party attribution keys, and nothing
 * third-party ever loads. The banner therefore shows even before analytics is
 * switched on for the build, because those first-party keys are written either
 * way and are what the visitor is actually consenting to.
 *
 * Deliberately plain language — this is read by 20-year-old graduates and by
 * working professionals on a phone, not by lawyers. No dark patterns: both
 * buttons are real, visible and the same size.
 *
 * Renders hidden and is revealed by its own inline script only when no choice
 * has been stored yet, so returning visitors never see a flash of it.
 * Sits above the WhatsApp FAB (z-50) while visible.
 */
import { siteConfig } from "../../config/site";
---

<div
  id="cookie-consent"
  hidden
  role="region"
  aria-label="Cookie choices"
  class="fixed inset-x-0 bottom-0 z-[60] border-t border-border bg-surface-75 shadow-lg"
>
  <div
    class="container-wide flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
  >
    <p class="text-sm leading-relaxed text-ink-600">
      We use cookies to see how people find our programs and to improve this site. The site works
      fine either way.{" "}
      <a
        href="/cookie-policy/"
        class="font-semibold text-accent-600 underline underline-offset-2 hover:text-accent-500"
        >Cookie Policy</a
      >
    </p>

    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-consent="denied"
        class="inline-flex flex-1 items-center justify-center whitespace-normal rounded-lg border-2 border-border px-4 py-2 text-sm font-bold text-ink-600 transition-colors hover:border-ink-400 hover:bg-surface-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 sm:flex-none sm:whitespace-nowrap"
      >
        Essential only
      </button>
      <button
        type="button"
        data-consent="granted"
        class="inline-flex flex-1 items-center justify-center whitespace-normal rounded-lg border-2 border-accent-500 bg-accent-500 px-5 py-2 text-sm font-bold text-white transition-colors hover:border-accent-600 hover:bg-accent-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-600 sm:flex-none sm:whitespace-nowrap"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById("cookie-consent");
    if (!el) return;

    var api = window.daitConsent;
    // Gate script missing (should not happen) — fail closed rather than show a
    // banner whose buttons would do nothing.
    if (!api) return;
    if (api.get()) return; // already chosen

    el.hidden = false;

    el.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-consent]");
      if (!btn) return;
      api.set(btn.getAttribute("data-consent"));
      el.hidden = true;
    });
  })();
</script>

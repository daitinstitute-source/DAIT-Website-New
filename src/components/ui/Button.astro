---
/**
 * Button — the one accent = interactive rule lives here.
 *   primary   : DAIT Blue (default primary CTA)
 *   secondary : DAIT Orange (accent CTA / highlight action)
 *   outline   : blue outline on light
 *   ghost     : subtle, low-emphasis
 *   ghost-on-dark : outline for dark sections
 * Renders <a> when `href` is set, else <button>.
 */
import { Icon } from "astro-icon/components";

type Variant = "primary" | "secondary" | "outline" | "ghost" | "ghost-on-dark";
type Size = "sm" | "md" | "lg";

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  icon?: string; // lucide icon name, trailing
  iconLeft?: string;
  type?: "button" | "submit" | "reset";
  external?: boolean;
  class?: string;
  id?: string;
  "data-reveal"?: boolean;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  icon,
  iconLeft,
  type = "button",
  external = false,
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-bold rounded-lg border-2 transition-all duration-200 whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:pointer-events-none motion-safe:hover:-translate-y-0.5";

const sizes: Record<Size, string> = {
  sm: "px-4 py-2 text-sm rounded-md",
  md: "px-6 py-3 text-[0.9rem]",
  lg: "px-8 py-4 text-base rounded-[10px]",
};

const variants: Record<Variant, string> = {
  primary:
    "bg-accent-500 text-white border-accent-500 hover:bg-accent-600 hover:border-accent-600 hover:shadow-lg focus-visible:outline-accent-600",
  secondary:
    "bg-orange-500 text-white border-orange-500 hover:bg-orange-600 hover:border-orange-600 hover:shadow-lg focus-visible:outline-orange-600",
  outline:
    "bg-transparent text-accent-500 border-accent-500 hover:bg-accent-50 focus-visible:outline-accent-600",
  ghost:
    "bg-transparent text-ink-600 border-border hover:bg-surface-75 hover:border-ink-400 focus-visible:outline-accent-500",
  "ghost-on-dark":
    "bg-transparent text-white border-white/40 hover:bg-white/10 hover:border-white/70 focus-visible:outline-white",
};

const cls = [base, sizes[size], variants[variant], className].join(" ");
const iconSize = size === "sm" ? 16 : 18;
const relAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} class={cls} {...relAttrs} {...rest}>
      {iconLeft && <Icon name={iconLeft} size={iconSize} />}
      <slot />
      {icon && <Icon name={icon} size={iconSize} />}
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      {iconLeft && <Icon name={iconLeft} size={iconSize} />}
      <slot />
      {icon && <Icon name={icon} size={iconSize} />}
    </button>
  )
}

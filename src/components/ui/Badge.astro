---
/**
 * Badge — small pill for area tags, levels, "next batch" etc.
 * tone: blue (default) | orange | neutral | dark
 */
type Tone = "blue" | "orange" | "neutral" | "dark";
interface Props {
  tone?: Tone;
  class?: string;
}
const { tone = "blue", class: className = "" } = Astro.props;

const tones: Record<Tone, string> = {
  blue: "bg-accent-50 text-accent-600",
  orange: "bg-orange-50 text-orange-600",
  neutral: "bg-surface-50 text-ink-500 border border-border",
  dark: "bg-white/10 text-white/90",
};
---

<span
  class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.7rem] font-bold uppercase tracking-wider ${tones[tone]} ${className}`}
>
  <slot />
</span>

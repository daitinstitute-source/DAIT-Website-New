---
/**
 * TestimonialStrip — student success quotes. Until real placements exist, these
 * are SAMPLE placeholders, clearly labelled so nothing reads as a real claim.
 * Later this reads from a testimonials/placements collection (Phase 3).
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";

// TODO: replace with real, consented student stories (Phase 3 placements collection).
const isSample = true;
const testimonials = [
  {
    quote:
      "The projects were the difference. I walked into interviews with real work to show, not just a certificate — and that's what got me the offer.",
    name: "Sample Student",
    detail: "Full-Stack track · placed as a Junior Developer",
    audience: "Graduate",
  },
  {
    quote:
      "Weekend batches meant I never had to choose between my job and upskilling. Six months later I switched into a data role with a real hike.",
    name: "Sample Student",
    detail: "Data & AI track · career switch",
    audience: "Working professional",
  },
];
---

<div class="max-w-2xl" data-reveal>
  <SectionLabel onDark>Student outcomes</SectionLabel>
  <h2 class="mt-3 text-3xl sm:text-4xl text-white">
    Built for <span class="text-orange-400">real careers</span>, not just certificates
  </h2>
  {
    isSample && (
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/70">
        <Icon name="lucide:info" size={14} />
        Sample stories — real, consented student results will replace these.
      </p>
    )
  }
</div>

<div class="mt-10 grid gap-6 md:grid-cols-2">
  {
    testimonials.map((t, i) => (
      <figure
        class="rounded-[18px] bg-white/5 ring-1 ring-white/10 p-7 flex flex-col"
        data-reveal
        data-reveal-delay={(i * 0.1).toString()}
      >
        <Icon name="lucide:quote" size={28} class="text-orange-500/70" />
        <blockquote class="mt-4 text-lg text-white/90 leading-relaxed flex-1">
          {t.quote}
        </blockquote>
        <figcaption class="mt-6 flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-500 text-white font-bold">
            <Icon name="lucide:user-round" size={20} />
          </span>
          <span>
            <span class="block text-sm font-bold text-white">{t.name}</span>
            <span class="block text-xs text-white/55">{t.detail}</span>
          </span>
          <span class="ml-auto rounded-full bg-white/10 px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wide text-white/60">
            {t.audience}
          </span>
        </figcaption>
      </figure>
    ))
  }
</div>

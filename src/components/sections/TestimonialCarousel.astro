---
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";

interface Testimonial {
  name: string;
  jobTitle: string;
  company: string;
  quote: string;
  rating?: number;
  salaryHike?: string;
}

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;

const renderStars = (rating: number = 5) => {
  return Array(rating)
    .fill(0)
    .map(() => "★")
    .join("");
};
---

<div id="testimonials">
  <div class="max-w-3xl" data-reveal>
    <SectionLabel>Success stories</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">Real outcomes from real learners</h2>
    <p class="mt-4 text-ink-600 measure">
      See how graduates and professionals transformed their careers after completing the program.
    </p>
  </div>

  {testimonials && testimonials.length > 0 ? (
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((testimonial, i) => (
        <div
          class="rounded-3xl border border-border bg-white p-8 shadow-sm hover:shadow-md transition-shadow"
          data-reveal
          data-reveal-delay={(i * 0.1).toString()}
        >
          <!-- Rating -->
          {testimonial.rating && (
            <div class="flex gap-1 text-orange-400 text-lg">
              {renderStars(testimonial.rating)}
            </div>
          )}

          <!-- Quote -->
          <blockquote class="mt-4 text-ink-700 font-medium italic">
            "{testimonial.quote}"
          </blockquote>

          <!-- Avatar Placeholder + Name -->
          <div class="mt-6 flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-accent-100 to-accent-50 shrink-0">
              <Icon name="lucide:user" size={24} class="text-accent-400" />
            </div>
            <div>
              <p class="font-bold text-ink-900">{testimonial.name}</p>
              <p class="text-sm text-accent-600 font-medium">{testimonial.jobTitle}</p>
              <p class="text-xs text-ink-500">{testimonial.company}</p>
            </div>
          </div>

          <!-- Salary Hike Badge -->
          {testimonial.salaryHike && (
            <div class="mt-4 rounded-2xl bg-green-50 px-4 py-3 text-center border border-green-200">
              <p class="text-xs text-green-600 uppercase font-bold tracking-widest">Salary Increase</p>
              <p class="mt-1 text-lg font-black text-green-700">{testimonial.salaryHike}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  ) : (
    <div class="mt-10 rounded-3xl border border-border border-dashed bg-surface-50 p-12 text-center">
      <p class="text-ink-500">Testimonials coming soon. Be the first to share your success story!</p>
    </div>
  )}
</div>

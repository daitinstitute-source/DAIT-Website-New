---
/**
 * InstructorsTeam — "who actually teaches you", on the homepage (DARK).
 *
 * The point of difference versus a plain photo wall: each card states the
 * person's real job title, the track they teach on, and which of the three
 * things they do for DAIT — Instructor, Masterclass, Industry Mentor. That is
 * the honest version of what upGrad-style faculty sections imply with logos.
 *
 * Photos are optional. A missing file degrades to an initials avatar, checked
 * at build time via existingImage, so a path can be wired before the photo
 * lands — same contract as LeadershipTeam.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";
import { existingImage } from "../../lib/media";
import { instructors } from "../../data/instructors";
import { programAreas } from "../../data/navigation";

const area = (slug: string) => programAreas.find((a) => a.slug === slug);

// Initials for the avatar fallback (drops honorifics), as used by LeadershipTeam.
const initials = (name: string) =>
  name
    .replace(/prof\.?|dr\.?|mr\.?|mrs\.?/gi, "")
    .trim()
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

<div id="instructors">
  <div class="max-w-2xl" data-reveal>
    <SectionLabel onDark>Who teaches you</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-white">
      Practitioners first, <span class="text-orange-400">trainers second</span>
    </h2>
    <p class="mt-4 text-white/70 measure">
      Every track is taught by someone doing the work — running campaigns, shipping
      infrastructure, building models. Several also run masterclasses and mentor learners
      beyond the classroom.
    </p>
  </div>

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      instructors.map((person, i) => {
        const a = area(person.area);
        const photo = existingImage(person.photo);
        return (
          <li
            class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.04] p-6 transition-colors hover:border-white/20"
            data-reveal
            data-reveal-delay={(i * 0.06).toString()}
          >
            <div class="flex items-center gap-4">
              {photo ? (
                <img
                  src={photo}
                  alt={person.name}
                  width="112"
                  height="112"
                  loading="lazy"
                  decoding="async"
                  class="h-14 w-14 shrink-0 rounded-xl object-cover"
                />
              ) : (
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-white/10 text-base font-black text-white/80">
                  {initials(person.name)}
                </span>
              )}
              <div class="min-w-0">
                <p class="flex items-center gap-1.5 text-base font-bold leading-tight text-white">
                  {person.name}
                  {person.linkedinUrl && (
                    <a
                      href={person.linkedinUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white/40 transition-colors hover:text-white"
                      aria-label={`${person.name} on LinkedIn`}
                    >
                      <Icon name="simple-icons:linkedin" size={14} />
                    </a>
                  )}
                </p>
                <p class="mt-0.5 text-sm leading-snug text-white/60">{person.role}</p>
              </div>
            </div>

            {a && (
              <p class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-orange-500/15 px-3 py-1 text-xs font-bold text-orange-300">
                <Icon name={a.icon} size={13} />
                {a.short}
              </p>
            )}

            <ul class="mt-4 flex flex-wrap gap-1.5">
              {person.teaches.map((t) => (
                <li class="rounded-full bg-white/10 px-2.5 py-1 text-[0.7rem] font-semibold text-white/75">
                  {t}
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ul>
</div>

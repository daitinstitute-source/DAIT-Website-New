---
/**
 * DaitDifference — the six pillars that define how DAIT teaches.
 * Homepage section (LIGHT). Deliberately separate from WhyDAIT.astro (which
 * program pages use with per-program benefits) so the homepage can carry its
 * own framing without any risk to those pages.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";

const pillars = [
  {
    title: "Industry-Led",
    description:
      "Taught by people who have done the work — practitioners with real industry experience, not full-time trainers.",
    icon: "lucide:briefcase-business",
  },
  {
    title: "AI-Ready",
    description:
      "AI tools and workflows are built into every relevant track from day one, not bolted on as a final module.",
    icon: "lucide:sparkles",
  },
  {
    title: "Practical",
    description:
      "Projects, assignments and real-world cases from the first month. You learn by building, not by watching.",
    icon: "lucide:blocks",
  },
  {
    title: "Mentored",
    description:
      "Guidance that continues past the classroom — reviews, doubt-clearing and direction when you get stuck.",
    icon: "lucide:handshake",
  },
  {
    title: "Career-Focused",
    description:
      "Portfolio, interview practice and professional skills are part of the curriculum, not an afterthought.",
    icon: "lucide:target",
  },
  {
    title: "Small Batches",
    description:
      "Cohorts are capped so every learner gets individual mentor attention — the opposite of a crowded lecture hall.",
    icon: "lucide:users-round",
  },
];
---

<div>
  <div class="max-w-2xl" data-reveal>
    <SectionLabel>The DAIT difference</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
      Six things that shape how we <span class="text-orange-500">teach</span>
    </h2>
    <p class="mt-4 text-ink-500 measure">
      The same standards apply whether you're a fresh graduate starting out or a working
      professional levelling up.
    </p>
  </div>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      pillars.map((p, i) => (
        <div
          class="card p-6 sm:p-7"
          data-reveal
          data-reveal-delay={(i * 0.06).toString()}
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
            <Icon name={p.icon} size={24} />
          </span>
          <h3 class="mt-4 text-lg font-bold text-ink-900">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{p.description}</p>
        </div>
      ))
    }
  </div>
</div>

---
/**
 * FoundingCohort — honest stand-in for a testimonials section while DAIT is new.
 * Shown ONLY when a program has no real, verifiable learner stories yet.
 * Turns "no social proof" into an early-adopter advantage instead of faking it.
 * Dark section (matches where TestimonialCarousel used to sit).
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";

interface Props {
  primaryCtaLink: string;
}
const { primaryCtaLink } = Astro.props;

const perks = [
  {
    icon: "lucide:users-round",
    title: "Smallest batch you'll ever be in",
    desc: "Founding cohorts stay tiny — you get direct mentor time, not a lecture hall.",
  },
  {
    icon: "lucide:pen-line",
    title: "Shape the program",
    desc: "Your feedback directly influences the curriculum, pace, and projects.",
  },
  {
    icon: "lucide:badge-percent",
    title: "Early-cohort pricing",
    desc: "Founding learners get our best fee and flexible payment options.",
  },
];
---

<div id="testimonials">
  <div class="max-w-3xl" data-reveal>
    <SectionLabel onDark>Be a founding learner</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-white">
      No recycled testimonials. Just an honest offer.
    </h2>
    <p class="mt-4 measure text-white/70">
      DAIT is new, so we won't show you stock photos and made-up salary hikes. Instead, our first
      cohorts get something later batches won't — a front-row seat, founder-led mentorship, and a say
      in how the program grows.
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {perks.map((perk, i) => (
      <div
        class="rounded-3xl bg-white/5 ring-1 ring-white/10 p-7"
        data-reveal
        data-reveal-delay={(i * 0.1).toString()}
      >
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-orange-500/15 text-orange-500">
          <Icon name={perk.icon} size={22} />
        </span>
        <h3 class="mt-5 text-lg font-bold text-white">{perk.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/60">{perk.desc}</p>
      </div>
    ))}
  </div>

  <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal>
    <Button href={primaryCtaLink}>Book free counselling</Button>
    <p class="text-sm text-white/55">Ask us anything — no commitment.</p>
  </div>
</div>

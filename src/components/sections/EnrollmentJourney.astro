---
/**
 * EnrollmentJourney — "how do I actually join?", on every program page (DARK).
 *
 * Sits immediately before the batch/enrolment block, because this is the point
 * where an interested reader starts worrying about commitment. Each step shows
 * a small reassurance chip answering the objection that step raises.
 *
 * Mobile-first: numbered vertical rail on phones, two columns at sm, five
 * across with a horizontal rail from lg.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";
import {
  enrollmentJourney,
  journeyIntro,
  seatIncludes,
  seatIncludesLabel,
} from "../../data/enrollment-journey";
---

<div id="how-to-join">
  <div class="max-w-2xl" data-reveal>
    <SectionLabel onDark>How to join</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-white">
      From first question to <span class="text-orange-400">first project</span>
    </h2>
    <p class="mt-4 text-white/70 measure">{journeyIntro}</p>
  </div>

  <div class="relative mt-12">
    <!-- Horizontal rail (lg+) behind the step markers -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-[1.375rem] hidden h-px bg-white/15 lg:block"
    >
    </div>

    <ol class="relative grid gap-8 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-5 lg:gap-6">
      {
        enrollmentJourney.map((step, i) => (
          <li
            class="relative flex gap-4 lg:block"
            data-reveal
            data-reveal-delay={(i * 0.08).toString()}
          >
            {/* Vertical rail between markers, phones only */}
            {i < enrollmentJourney.length - 1 && (
              <span
                aria-hidden="true"
                class="absolute left-[1.375rem] top-12 -bottom-8 w-px bg-white/15 sm:hidden"
              />
            )}

            <span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-orange-500 text-white ring-4 ring-dark-950">
              <Icon name={step.icon} size={19} />
            </span>

            <div class="min-w-0 lg:mt-5">
              <p class="text-[0.7rem] font-bold uppercase tracking-wider text-white/40">
                Step {i + 1}
              </p>
              <p class="mt-0.5 text-sm font-black text-white">{step.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-white/65">{step.body}</p>
              {step.note && (
                <p class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-1 text-[0.7rem] font-semibold text-white/75">
                  <Icon name="lucide:check" size={12} class="text-orange-400" />
                  {step.note}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  {
    seatIncludes.length > 0 && (
      <div class="mt-12 rounded-2xl border border-white/10 bg-white/[0.04] p-6 sm:p-7" data-reveal>
        <p class="text-xs font-bold uppercase tracking-wider text-orange-400">
          {seatIncludesLabel}
        </p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {seatIncludes.map((item) => (
            <li class="flex items-center gap-3 text-sm text-white/80">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-orange-300">
                <Icon name={item.icon} size={17} />
              </span>
              {item.label}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

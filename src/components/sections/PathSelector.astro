---
/**
 * PathSelector — the 3-audience router (Learners / Colleges / Companies).
 * Homepage section, light. Each card links to that audience's landing page.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";

const paths = [
  {
    icon: "lucide:graduation-cap",
    tag: "I want to learn",
    title: "Courses & career programs",
    desc: "Structured, mentor-led programs in AI, software, data & digital — for students and working professionals.",
    href: "/programs/",
    cta: "Explore programs",
  },
  {
    icon: "lucide:school",
    tag: "I'm from a college",
    title: "Campus training & placements",
    desc: "Industry-aligned workshops, bootcamps, FDPs and placement-readiness training for your students.",
    href: "/for-colleges/",
    cta: "Partner with us",
  },
  {
    icon: "lucide:building-2",
    tag: "I'm a company / agency",
    title: "Corporate training & hiring",
    desc: "Upskill your team on current tools, or hire talent that's productive from day one.",
    href: "/for-companies/",
    cta: "Train or hire",
  },
];
---

<div>
  <div class="max-w-2xl" data-reveal>
    <SectionLabel>Built for three journeys</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">Choose your <span class="text-orange-500">path</span></h2>
    <p class="mt-4 text-ink-500 measure">
      Learners, colleges and companies each get a focused path — choose yours and we'll take you
      straight to what's relevant.
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {paths.map((p, i) => (
      <a href={p.href} class="card card--hover group flex flex-col p-7" data-reveal data-reveal-delay={(i * 0.08).toString()}>
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-50 text-accent-600 transition-colors group-hover:bg-accent-500 group-hover:text-white">
          <Icon name={p.icon} size={24} />
        </span>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-orange-600">{p.tag}</p>
        <h3 class="mt-1 text-xl font-bold text-ink-900">{p.title}</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{p.desc}</p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-accent-600 transition-all group-hover:gap-2.5">
          {p.cta}
          <Icon name="lucide:arrow-right" size={16} />
        </span>
      </a>
    ))}
  </div>
</div>

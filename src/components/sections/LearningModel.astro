---
/**
 * LearningModel — the DAIT Learning Model: LEARN → BUILD → MENTOR → PROVE → LAUNCH.
 * Homepage section (DARK). Self-contained: owns its own copy and steps, so it can
 * be dropped in or pulled out without touching anything else.
 *
 * Layout is mobile-first: a vertical numbered rail on phones, flowing to a
 * five-across row with a horizontal rail from lg up.
 */
import SectionLabel from "../ui/SectionLabel.astro";

const steps = [
  {
    title: "Learn",
    body: "Understand the concepts through structured, industry-informed teaching — not recorded lectures you watch alone.",
  },
  {
    title: "Build",
    body: "Apply them straight away on practical projects, assignments and real-world cases.",
  },
  {
    title: "Mentor",
    body: "Get reviews, direction and doubt-clearing from professionals who have done the work.",
  },
  {
    title: "Prove",
    body: "Turn that work into a portfolio that demonstrates what you can actually do.",
  },
  {
    title: "Launch",
    body: "Prepare for internships, a first job, a career switch or growth in your current role.",
  },
];
---

<div>
  <div class="max-w-2xl" data-reveal>
    <SectionLabel onDark>The DAIT learning model</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-white">
      How a DAIT program actually <span class="text-orange-400">works</span>
    </h2>
    <p class="mt-4 text-white/70 measure">
      Every program follows the same five stages — so you always know what you're doing now,
      and what it's building towards.
    </p>
  </div>

  <div class="relative mt-12">
    <!-- Horizontal rail (lg+ only) sits behind the step markers -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-[1.375rem] hidden h-px bg-white/15 lg:block"
    >
    </div>

    <ol class="relative grid gap-8 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-5 lg:gap-6">
      {
        steps.map((s, i) => (
          <li class="relative flex gap-4 lg:block" data-reveal data-reveal-delay={(i * 0.08).toString()}>
            {/* Vertical rail between markers on phones only */}
            {i < steps.length - 1 && (
              <span
                aria-hidden="true"
                class="absolute left-[1.375rem] top-12 -bottom-8 w-px bg-white/15 sm:hidden"
              />
            )}
            <span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-orange-500 text-sm font-black text-white ring-4 ring-dark-950">
              {i + 1}
            </span>
            <div class="min-w-0 lg:mt-5">
              <p class="text-sm font-black uppercase tracking-wider text-white">{s.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-white/65">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>

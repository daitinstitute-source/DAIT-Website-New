---
/**
 * BatchEnrollment — batch schedule + a highlighted "next batch / book" card +
 * the enrollment-journey stepper. Light, clean layout (replaces the old dark block).
 */
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import SectionLabel from "../ui/SectionLabel.astro";
import { siteConfig } from "../../config/site";

const pricing = siteConfig.pricing;

interface Props {
  batchOptions: string[];
  nextBatchDate?: string;
  fee?: string;
  duration: string;
  primaryCtaLink: string;
}
const { batchOptions, nextBatchDate, fee, duration, primaryCtaLink } = Astro.props;

// Fees and batch start dates are hidden site-wide via siteConfig.display —
// see config/site.ts. With the date hidden this card falls back to its
// "New batches every month" line, so the panel still reads complete.
const shownFee = siteConfig.display.showFees ? fee : undefined;
const shownNextBatchDate = siteConfig.display.showNextBatchDate ? nextBatchDate : undefined;

const batchMeta = (opt: string) =>
  /weekend|sat|sun|evening/i.test(opt)
    ? {
        icon: "lucide:calendar-heart",
        tag: "For working professionals",
        desc: "Weekend & evening sessions — learn while you earn.",
      }
    : {
        icon: "lucide:sunrise",
        tag: "For freshers & full-timers",
        desc: "Weekday sessions with a structured daily pace.",
      };

const steps = [
  { label: "Book a call", desc: "Talk to an advisor" },
  { label: "Program fit", desc: "Find the right batch" },
  { label: "Enroll", desc: "Complete registration" },
  { label: "Start learning", desc: "Join your batch" },
];
---

<div id="enrollment">
  <div class="max-w-2xl" data-reveal>
    <SectionLabel>Batches & enrollment</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
      Pick a schedule that <span class="text-orange-500">fits your week</span>
    </h2>
    <p class="mt-4 text-ink-500 measure">
      Weekday and weekend/evening batches run through the year. Reserve your seat with a free,
      no-obligation counselling call.
    </p>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1.4fr_0.6fr] lg:items-stretch">
    <!-- Batch option cards -->
    <div class="grid gap-4 sm:grid-cols-2">
      {batchOptions.map((option) => {
        const m = batchMeta(option);
        return (
          <div class="rounded-3xl border border-border bg-white p-6 shadow-sm" data-reveal>
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
                <Icon name={m.icon} size={22} />
              </span>
              <div>
                <p class="text-[0.65rem] font-bold uppercase tracking-wider text-accent-600">{m.tag}</p>
                <h3 class="text-lg font-bold text-ink-900">{option}</h3>
              </div>
            </div>
            <p class="mt-3 text-sm text-ink-500">{m.desc}</p>
          </div>
        );
      })}
    </div>

    <!-- Next batch + CTA -->
    <div class="relative flex flex-col overflow-hidden rounded-3xl bg-gradient-to-br from-accent-600 to-accent-500 p-6 text-white shadow-lg" data-reveal>
      <div aria-hidden="true" class="pointer-events-none absolute -right-10 -top-12 h-40 w-40 rounded-full" style="background: radial-gradient(circle, rgba(242,99,33,.4), transparent 65%);"></div>
      <div class="relative">
        {shownNextBatchDate ? (
          <>
            <p class="text-xs font-bold uppercase tracking-wider text-white/70">Next batch starts</p>
            <p class="mt-1 text-2xl font-black">{shownNextBatchDate}</p>
          </>
        ) : (
          <p class="text-lg font-bold">New batches every month</p>
        )}
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-white/15 px-2.5 py-1 text-xs font-bold">{duration}</span>
          {shownFee && <span class="rounded-full bg-orange-500 px-2.5 py-1 text-xs font-bold">{shownFee}</span>}
        </div>
        {shownFee && (
          <p class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-orange-200">
            <Icon name="lucide:sparkles" size={12} /> {pricing.launchLabel}
          </p>
        )}
      </div>
      <div class="relative mt-auto pt-6">
        <Button href={primaryCtaLink} class="w-full justify-center !border-white !bg-white !text-accent-600 hover:!bg-white/90 hover:!border-white/90">
          Book free counselling
        </Button>
        <p class="mt-2 text-center text-xs text-white/70">Limited seats · no commitment</p>
      </div>
    </div>
  </div>

  <!-- Enrollment journey stepper -->
  <div class="mt-8 rounded-3xl border border-border bg-white p-6 sm:p-8" data-reveal>
    <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-500">Your enrollment journey</p>
    <ol class="mt-6 grid gap-6 sm:grid-cols-4">
      {steps.map((s, i) => (
        <li>
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-500 text-base font-black text-white">
              {i + 1}
            </span>
            {i < steps.length - 1 && <span class="hidden h-0.5 flex-1 bg-border sm:block" />}
          </div>
          <p class="mt-3 font-bold text-ink-900">{s.label}</p>
          <p class="mt-1 text-sm text-ink-500">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</div>

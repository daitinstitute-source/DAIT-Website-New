---
/**
 * ProgramComparison — "What makes this program stand out?" — DAIT vs a typical
 * institute, upGrad-style. Rows are honest DAIT differentiators (no invented
 * stats). Generic across programs; the DAIT column is labelled with the program.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";

interface Props {
  programTitle: string;
}
const { programTitle } = Astro.props;

const rows = [
  { feature: "Learning focus", icon: "lucide:book-open", dait: "Project-based, end-to-end execution", others: "Theory-heavy modules" },
  { feature: "Curriculum", icon: "lucide:layers", dait: "Two tracks — Foundation & Advanced", others: "One-size-fits-all syllabus" },
  { feature: "Hands-on depth", icon: "lucide:wrench", dait: "Live projects with real tools & budgets", others: "Assignment-only practice" },
  { feature: "Tools exposure", icon: "lucide:sparkles", dait: "Current industry + AI tools", others: "Basic tool walkthroughs" },
  { feature: "Mentorship", icon: "lucide:user-check", dait: "Founder-led, small batches", others: "Rotating part-time trainers" },
  { feature: "Industry alignment", icon: "lucide:trending-up", dait: "Curriculum matched to current hiring", others: "Outdated or generic content" },
  { feature: "Certification", icon: "lucide:badge-check", dait: "Industry certification prep included", others: "Course certificate only" },
  { feature: "Career support", icon: "lucide:life-buoy", dait: "Portfolio, resume & mock interviews", others: "Limited placement guidance" },
];
---

<div>
  <div class="max-w-2xl" data-reveal>
    <SectionLabel>How we compare</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
      What makes this program <span class="text-orange-500">stand out?</span>
    </h2>
  </div>

  <div class="mt-10 overflow-x-auto" data-reveal>
    <table class="w-full min-w-[680px] border-collapse text-left">
      <thead>
        <tr>
          <th class="w-[26%] pb-4"></th>
          <th class="w-[42%] rounded-t-2xl border-x border-t border-accent-200 bg-accent-50/60 px-5 py-4">
            <span class="block text-xs font-bold uppercase tracking-wider text-accent-600">At DAIT</span>
            <span class="mt-0.5 block text-base font-black text-ink-900">{programTitle}</span>
          </th>
          <th class="px-5 py-4 align-bottom text-sm font-bold text-ink-500">Other institutes</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r, i) => (
          <tr class="border-t border-border">
            <td class="py-4 pr-4">
              <span class="flex items-center gap-2.5 font-bold text-ink-900">
                <Icon name={r.icon} size={18} class="shrink-0 text-accent-600" />
                {r.feature}
              </span>
            </td>
            <td class={`border-x border-accent-200 bg-accent-50/60 px-5 py-4 ${i === rows.length - 1 ? "rounded-b-2xl border-b" : ""}`}>
              <span class="flex items-start gap-2.5 text-sm text-ink-700">
                <Icon name="lucide:check" size={18} class="mt-0.5 shrink-0 text-green-600" />
                {r.dait}
              </span>
            </td>
            <td class="px-5 py-4">
              <span class="flex items-start gap-2.5 text-sm text-ink-400">
                <Icon name="lucide:x" size={18} class="mt-0.5 shrink-0 text-ink-300" />
                {r.others}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

---
/**
 * OtherCourses — a horizontal slider of the institute's other programs, shown
 * near the bottom of a program page. Reuses ProgramCard. Scroll-snap + hidden
 * scrollbar; prev/next buttons scroll programmatically (only when it overflows).
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";
import ProgramCard from "./ProgramCard.astro";

interface Program {
  id: string;
  data: {
    title: string;
    tagline: string;
    area: string;
    duration: string;
    mode: string[];
    level: string;
    nextBatchDate?: Date;
  };
}
interface Props {
  programs: Program[];
}
const { programs } = Astro.props;
const showNav = programs.length > 2;
---

{programs.length > 0 && (
  <div data-other-courses>
    <div class="flex items-end justify-between gap-4">
      <div class="max-w-2xl" data-reveal>
        <SectionLabel>More programs</SectionLabel>
        <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
          Explore <span class="text-orange-500">other courses</span>
        </h2>
      </div>
      {showNav && (
        <div class="hidden shrink-0 gap-2 sm:flex">
          <button type="button" data-other-dir="-1" aria-label="Previous" class="flex h-11 w-11 items-center justify-center rounded-full border border-border bg-white text-ink-600 transition hover:border-accent-500 hover:text-accent-600">
            <Icon name="lucide:chevron-left" size={20} />
          </button>
          <button type="button" data-other-dir="1" aria-label="Next" class="flex h-11 w-11 items-center justify-center rounded-full border border-border bg-white text-ink-600 transition hover:border-accent-500 hover:text-accent-600">
            <Icon name="lucide:chevron-right" size={20} />
          </button>
        </div>
      )}
    </div>

    <div class="othercourses-scroll mt-8 flex snap-x gap-6 overflow-x-auto scroll-smooth pb-2" data-other-track>
      {programs.map((p) => (
        <div class="w-[300px] shrink-0 snap-start sm:w-[340px]">
          <ProgramCard slug={p.id} data={p.data} />
        </div>
      ))}
    </div>

    <a href="/programs/" class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-accent-600 hover:gap-2.5 transition-all">
      View all programs
      <Icon name="lucide:arrow-right" size={16} />
    </a>
  </div>
)}

<style>
  .othercourses-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .othercourses-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const root = document.querySelector("[data-other-courses]");
  const track = root?.querySelector<HTMLElement>("[data-other-track]");
  root?.querySelectorAll<HTMLButtonElement>("[data-other-dir]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dir = Number(btn.dataset.otherDir) || 1;
      track?.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: "smooth" });
    });
  });
</script>

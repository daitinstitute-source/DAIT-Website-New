---
/**
 * AudienceSplit — the two-path "Just Graduated? / Working Professional?" block.
 * Reused on the homepage (§6) and the Programs hub. Enforces the core rule:
 * always speak to BOTH audiences. Light section.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";

interface Props {
  heading?: string;
  intro?: string;
}
const {
  heading = "One goal, two structured routes",
  intro = "Whether you're stepping out of college or advancing mid-career, there's a rigorous, mentor-led route built for your situation.",
} = Astro.props;

const paths = [
  {
    tag: "Just graduated?",
    icon: "lucide:graduation-cap",
    title: "From your degree to your first job",
    points: [
      "Weekday cohorts with a structured, foundations-first path",
      "Placement support: portfolio, resume, and mock interviews",
      "Affordable fees with EMI options",
    ],
    cta: { label: "Programs for graduates", href: "/programs/" },
  },
  {
    tag: "Working professional?",
    icon: "lucide:briefcase",
    title: "Upskill or switch careers without pausing your job",
    points: [
      "Weekend & evening cohorts — learn while you earn",
      "Advanced tracks for career switches and salary growth",
      "Practical, project-first learning that fits a working week",
    ],
    cta: { label: "Programs for professionals", href: "/programs/" },
  },
];
---

<div class="max-w-2xl" data-reveal>
  <SectionLabel>Who it's for</SectionLabel>
  <h2 class="mt-3 text-3xl sm:text-4xl">{heading}</h2>
  <p class="mt-4 text-ink-500 measure">{intro}</p>
</div>

<div class="mt-10 grid gap-6 md:grid-cols-2">
  {
    paths.map((path, i) => (
      <div
        class="card card--hover p-8 flex flex-col"
        data-reveal
        data-reveal-delay={(i * 0.1).toString()}
      >
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-accent-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent-600">
          <Icon name={path.icon} size={16} />
          {path.tag}
        </span>
        <h3 class="mt-4 text-xl text-ink-900">{path.title}</h3>
        <ul class="mt-4 space-y-2.5 flex-1">
          {path.points.map((pt) => (
            <li class="flex items-start gap-2.5 text-sm text-ink-600">
              <Icon
                name="lucide:check"
                size={18}
                class="mt-0.5 shrink-0 text-orange-500"
              />
              {pt}
            </li>
          ))}
        </ul>
        <a
          href={path.cta.href}
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-accent-600 hover:gap-2.5 transition-all"
        >
          {path.cta.label}
          <Icon name="lucide:arrow-right" size={16} />
        </a>
      </div>
    ))
  }
</div>

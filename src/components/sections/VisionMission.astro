---
/**
 * VisionMission — the "why we exist" band for /why-dait. Dark. Frames DAIT as the
 * Dhakne family's answer to the education→employment gap. Honest, authoritative.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";
import { siteConfig } from "../../config/site";

const g = siteConfig.group;
const years = new Date().getFullYear() - g.established;

const beliefs = [
  { icon: "lucide:hammer", title: "Practical over theoretical", desc: "You learn by building — live projects, real tools, real portfolios." },
  { icon: "lucide:sparkles", title: "AI-first, always", desc: "We teach with the AI tools reshaping every industry today." },
  { icon: "lucide:users-round", title: "Mentorship, not lectures", desc: "Small, founder-led cohorts with personal attention." },
  { icon: "lucide:heart-handshake", title: "Access for everyone", desc: "Affordable paths for freshers and working professionals alike." },
];
---

<div>
  <div class="max-w-3xl" data-reveal>
    <SectionLabel onDark>Our purpose</SectionLabel>
    <h2 class="mt-3 text-3xl sm:text-4xl text-white">
      Bridging the gap from <span class="text-orange-400">education to employment</span>
    </h2>
    <p class="mt-4 measure text-white/70">
      For over {years} years, our family has educated Sambhaji Nagar — from pre-school through Class 12.
      But a degree alone no longer guarantees a career. DAIT is our next chapter: turning learners into
      industry-ready talent for the AI era, right here at home.
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <div class="rounded-3xl bg-white/5 p-7 ring-1 ring-white/10" data-reveal>
      <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent-500/20 text-accent-200">
        <Icon name="lucide:telescope" size={22} />
      </span>
      <h3 class="mt-5 text-lg font-bold text-white">Our vision</h3>
      <p class="mt-2 leading-relaxed text-white/75">
        To make Sambhaji Nagar a launchpad for AI-era careers — where any motivated learner, whatever
        their background, can become industry-ready talent without leaving home.
      </p>
    </div>
    <div class="rounded-3xl bg-white/5 p-7 ring-1 ring-white/10" data-reveal data-reveal-delay="0.1">
      <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-orange-500/20 text-orange-300">
        <Icon name="lucide:target" size={22} />
      </span>
      <h3 class="mt-5 text-lg font-bold text-white">Our mission</h3>
      <p class="mt-2 leading-relaxed text-white/75">
        To bridge education and employment through practical, AI-first, industry-aligned training —
        real projects, mentorship, and the tools companies actually hire for — so every graduate leaves
        genuinely job-ready.
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {beliefs.map((b, i) => (
      <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10" data-reveal data-reveal-delay={(i * 0.06).toString()}>
        <Icon name={b.icon} size={20} class="text-orange-300" />
        <p class="mt-3 font-bold text-white">{b.title}</p>
        <p class="mt-1 text-sm leading-snug text-white/60">{b.desc}</p>
      </div>
    ))}
  </div>
</div>

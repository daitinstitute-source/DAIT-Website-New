---
/**
 * Hero — homepage §1, upGrad-style split layout: statement copy + program
 * chips + honest proof stats on the left, a "Request a Callback" lead form on
 * the right, over a photo with a dark scrim. No invented placement numbers.
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import HeroBackdrop from "./HeroBackdrop.astro";
import EnquiryForm from "../forms/EnquiryForm.tsx";
import { siteConfig } from "../../config/site";
import { programAreas } from "../../data/navigation";

const g = siteConfig.group;

// Callback-form dropdown: live programs, plus the College & Company ICPs so
// partners and employers route to the right place (values match /for-* pages).
const programs = [
  ...(await getCollection("programs"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => a.data.order - b.data.order)
    .map((p) => ({ slug: p.id, title: p.data.title })),
  { slug: "for-colleges", title: "For colleges — campus partnership" },
  // Companies option appears only while that track is live — see siteConfig.display.
  ...(siteConfig.display.showForCompanies
    ? [{ slug: "for-companies", title: "For companies — hire & upskill" }]
    : []),
];

// Honest proof only — legacy, curriculum, outcomes. No fabricated numbers.
const stats = [
  { value: "Since 1998", label: "Education legacy in Sambhaji Nagar" },
  { value: "AI-Forward Curriculum", label: "Modern tools in every session" },
  { value: "Career-Focused", label: "Portfolio + guidance included" },
];
---

<section class="relative overflow-hidden text-white">
  <HeroBackdrop name="students" overlay="dark" />
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 30px 30px;"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-28 h-[30rem] w-[30rem] rounded-full" style="background: radial-gradient(circle, rgba(242,99,33,.22), transparent 62%);"></div>

  <div class="container-wide relative py-9 lg:py-11">
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
      <!-- ── Left: statement + chips + stats ── -->
      <div data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-sm">
          <Icon name="lucide:landmark" size={14} class="text-orange-400" />
          A {g.name} Institute · Sambhaji Nagar
        </p>

        <h1 class="mt-5 text-[2rem] font-black leading-[1.06] tracking-tight text-white sm:text-[2.6rem] lg:text-5xl">
          Industry-Aligned Classroom Programs for <span class="text-orange-400">AI, Data &amp; Tech</span> Careers in Sambhajinagar
        </h1>

        <p class="mt-4 max-w-xl text-base font-medium leading-relaxed text-white/85 sm:text-lg">
          Designed with industry inputs and focused on real-world application — for fresh graduates
          launching a career and working professionals levelling up.
        </p>

        <!-- Program-track chips -->
        <div class="mt-6">
          <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-wider text-white/60">
            Explore our programs
            <span class="h-px flex-1 bg-white/15"></span>
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {programAreas.map((a) => (
              <a
                href={`/programs/#${a.slug}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:border-white/50 hover:bg-white/20"
              >
                <Icon name={a.icon} size={15} class="text-orange-300" />
                {a.short}
              </a>
            ))}
          </div>
        </div>

        <!-- Proof stat cards -->
        <dl class="mt-6 grid gap-3 sm:grid-cols-3">
          {stats.map((s, i) => (
            <div
              class="rounded-xl border border-white/15 bg-white/[0.07] p-4 backdrop-blur-sm"
              style={`border-top: 3px solid rgba(242,99,33,${0.55 - i * 0.12});`}
              data-reveal
              data-reveal-delay={(i * 0.06).toString()}
            >
              <dd class="text-lg font-black leading-tight text-white">{s.value}</dd>
              <dt class="mt-1 text-xs leading-snug text-white/70">{s.label}</dt>
            </div>
          ))}
        </dl>
      </div>

      <!-- ── Right: callback form ── -->
      <div data-reveal data-reveal-delay="0.1" class="lg:pl-2">
        <EnquiryForm
          client:load
          heading="Request a Callback"
          subheading="Share your details and a career advisor will call you back with cohort dates, fees, and the right track for your goals."
          programs={programs}
          hideMessage
        />
      </div>
    </div>
  </div>
</section>

---
/**
 * LegacyGroup — the Dhakne Education Group (est. 1998) trust block.
 * DAIT's single biggest USP: it is the family's newest institution, backed by
 * 25+ years of trusted schools & coaching in Sambhaji Nagar.
 *
 * variant="bar"  → compact band (used on the homepage, right under the hero)
 * variant="full" → full section with story + institution cards (About page)
 *
 * Institution logos render only when siteConfig.group.showLogos is true AND a
 * logo path is set — otherwise a clean text card, so nothing ever shows broken.
 */
import { Icon } from "astro-icon/components";
import SectionLabel from "../ui/SectionLabel.astro";
import { siteConfig } from "../../config/site";

interface Props {
  variant?: "bar" | "full";
  onDark?: boolean;
}
const { variant = "full", onDark = false } = Astro.props;
const g = siteConfig.group;
const showLogo = (logo: string) => g.showLogos && logo.length > 0;
---

{variant === "bar" ? (
  <div
    class="flex flex-col gap-5 lg:flex-row lg:items-center lg:gap-8"
    data-reveal
  >
    <div class="flex items-center gap-3 lg:max-w-[17rem] lg:shrink-0">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
        <Icon name="lucide:landmark" size={22} />
      </span>
      <p class="text-sm font-semibold text-ink-900">
        A <span class="text-accent-600">Dhakne Education Group</span> initiative
        <span class="block text-xs font-medium text-ink-500">Serving Sambhaji Nagar since {g.established}</span>
      </p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-3 gap-y-2 lg:ml-auto">
      {g.institutions.map((inst) => (
        <li class="flex items-center gap-2 rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-bold text-ink-600">
          <Icon name="lucide:graduation-cap" size={14} class="text-accent-500" />
          {inst.name}
        </li>
      ))}
    </ul>
  </div>
) : (
  <div>
    <div class="max-w-2xl" data-reveal>
      <SectionLabel onDark={onDark}>Our legacy</SectionLabel>
      <h2 class={`mt-3 text-3xl sm:text-4xl ${onDark ? "text-white" : "text-ink-900"}`}>
        25+ years of educating <span class="text-orange-500">Sambhaji Nagar</span>
      </h2>
      <p class={`mt-4 measure ${onDark ? "text-white/70" : "text-ink-500"}`}>
        {g.blurb}
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {g.institutions.map((inst, i) => (
        <div
          class={`rounded-3xl border p-6 ${onDark ? "border-white/10 bg-white/5" : "border-border bg-white shadow-sm"}`}
          data-reveal
          data-reveal-delay={(i * 0.08).toString()}
        >
          {showLogo(inst.logo) ? (
            <div class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl bg-white ring-1 ring-border">
              <img
                src={inst.logo}
                alt={`${inst.name} logo`}
                class="max-h-14 max-w-14 object-contain"
                width="56"
                height="56"
              />
            </div>
          ) : (
            <span class={`flex h-16 w-16 items-center justify-center rounded-2xl ${onDark ? "bg-orange-500/15 text-orange-400" : "bg-accent-50 text-accent-600"}`}>
              <Icon name="lucide:school" size={26} />
            </span>
          )}
          <h3 class={`mt-4 text-base font-bold ${onDark ? "text-white" : "text-ink-900"}`}>
            {inst.name}
          </h3>
          <p class={`mt-1 text-xs font-medium uppercase tracking-wide ${onDark ? "text-white/50" : "text-ink-500"}`}>
            {inst.type}
          </p>
        </div>
      ))}
    </div>

    <p class={`mt-6 flex items-center gap-2 text-sm ${onDark ? "text-white/60" : "text-ink-500"}`}>
      <Icon name="lucide:badge-check" size={16} class="text-accent-500" />
      Trusted by thousands of Sambhaji Nagar families since {g.established}.
    </p>
  </div>
)}

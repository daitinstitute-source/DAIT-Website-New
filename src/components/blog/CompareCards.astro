---
/**
 * CompareCards — side-by-side option comparison for articles.
 *
 * A real <table> is hostile on a phone, so each option is a card instead:
 * one column on mobile, a row of columns from lg. Every card ends in a link,
 * which is the point — a comparison block is where a reader decides.
 *
 * Deliberately has no "fee" row: fees are hidden site-wide via
 * siteConfig.display.showFees, and this block must not become a back door.
 */
import { Icon } from "astro-icon/components";

interface Option {
  title: string;
  tagline: string;
  icon: string;
  /** Label/value pairs — keep the same labels across options so they line up. */
  rows: Array<{ label: string; value: string }>;
  href: string;
  cta: string;
  /** Adds an orange "Most popular"-style flag. At most one. */
  flag?: string;
}
interface Props {
  options: Option[];
  caption?: string;
}
const { options, caption } = Astro.props as Props;
---

<div class="viz my-9">
  <div class="grid gap-5 lg:grid-cols-3">
    {
      options.map((o, i) => (
        <div
          class={`relative flex flex-col rounded-2xl border bg-white p-6 shadow-sm ${
            o.flag ? "border-orange-300" : "border-border"
          }`}
          data-reveal
          data-reveal-delay={(i * 0.08).toString()}
        >
          {o.flag && (
            <span class="absolute -top-3 left-6 rounded-full bg-orange-500 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-white">
              {o.flag}
            </span>
          )}

          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
            <Icon name={o.icon} size={22} />
          </span>
          <h3 class="mt-4 text-lg font-bold text-ink-900">{o.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{o.tagline}</p>

          <dl class="mt-5 space-y-3 border-t border-border pt-4">
            {o.rows.map((r) => (
              <div class="flex items-baseline justify-between gap-3">
                <dt class="shrink-0 text-xs font-bold uppercase tracking-wider text-ink-400">
                  {r.label}
                </dt>
                <dd class="text-right text-sm font-semibold text-ink-900">{r.value}</dd>
              </div>
            ))}
          </dl>

          <a
            href={o.href}
            class="mt-6 inline-flex items-center justify-center gap-1.5 rounded-lg border-2 border-accent-500 px-4 py-2.5 text-sm font-bold text-accent-600 transition-colors hover:bg-accent-500 hover:text-white"
          >
            {o.cta}
            <Icon name="lucide:arrow-right" size={15} />
          </a>
        </div>
      ))
    }
  </div>
  {caption && <p class="mt-3 text-center text-xs text-ink-500">{caption}</p>}
</div>

---
/**
 * BarChart — horizontal bar chart for magnitude comparisons inside an article.
 *
 * Follows the house dataviz rules: one hue for a single series (magnitude is
 * already encoded by length, so hue carries no second meaning), an optional
 * single emphasis bar, thin marks (16px) with a 4px rounded data-end and a
 * square baseline, no gridlines (every bar is direct-labelled), and recessive
 * chrome. Labels and values wear ink tokens — never the mark colour.
 */
interface Item {
  label: string;
  /** Numeric magnitude — drives bar length. */
  value: number;
  /** Text shown at the bar tip. Defaults to the raw value. */
  display?: string;
  /** Small muted line under the label, e.g. an observed range. */
  note?: string;
  /** Highlights this bar in orange — at most one per chart. */
  emphasis?: boolean;
}
interface Props {
  title: string;
  subtitle?: string;
  items: Item[];
  /** Scale ceiling. Defaults to the largest value. */
  max?: number;
  source?: string;
}
const { title, subtitle, items, max, source } = Astro.props as Props;

const ceiling = max ?? Math.max(...items.map((i) => i.value));
const pct = (v: number) =>
  ceiling > 0 ? Math.max(2, Math.round((v / ceiling) * 100)) : 0;
---

<figure class="viz my-9 rounded-2xl border border-border bg-white p-6 shadow-sm sm:p-7">
  <figcaption>
    <span class="block text-base font-bold text-ink-900">{title}</span>
    {
      subtitle && (
        <span class="mt-1 block text-sm text-ink-500">{subtitle}</span>
      )
    }
  </figcaption>

  <ul class="mt-6 space-y-5">
    {
      items.map((i) => (
        <li>
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-sm font-semibold text-ink-600">{i.label}</span>
            <span class="shrink-0 text-sm font-bold text-ink-900">
              {i.display ?? i.value}
            </span>
          </div>
          <div class="mt-2 h-4 w-full overflow-hidden rounded-sm bg-border">
            <div
              class={`h-full rounded-r-sm ${i.emphasis ? "bg-orange-500" : "bg-accent-500"}`}
              style={`width:${pct(i.value)}%`}
            />
          </div>
          {i.note && (
            <span class="mt-1.5 block text-xs text-ink-500">{i.note}</span>
          )}
        </li>
      ))
    }
  </ul>

  {
    source && (
      <p class="mt-6 border-t border-border pt-4 text-xs leading-relaxed text-ink-500">
        {source}
      </p>
    )
  }
</figure>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/ui/Section.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Button from "../../components/ui/Button.astro";
import ProgramCard from "../../components/sections/ProgramCard.astro";
import { programAreas, primaryCta } from "../../data/navigation";

const allPrograms = (await getCollection("programs")).filter((p) => !p.data.draft);

const programsByArea = programAreas.map((area) => ({
  ...area,
  programs: allPrograms.filter((p) => p.data.area === area.slug),
}));
---

<BaseLayout title="Programs | DAIT Institute" description="Explore DAIT Institute programs for graduates and working professionals in software development, data analytics, digital marketing, and cloud skills." canonicalPath="/programs/">
  <Section tone="dark" class="pt-24 pb-16">
    <div class="max-w-3xl" data-reveal>
      <SectionLabel>Programs</SectionLabel>
      <h1 class="mt-4 text-4xl sm:text-5xl font-black tracking-tight text-white">
        Choose a career track built for both freshers and working professionals
      </h1>
      <p class="mt-5 text-lg text-white/70 max-w-2xl">
        Each program mixes practical projects, mentor guidance, and AI-driven workflows so you can move faster from learning to earning.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={primaryCta.href}>{primaryCta.label}</Button>
        <Button href="#all-programs" variant="outline" class="!border-white/20 !text-white">
          Explore programs
        </Button>
      </div>
    </div>
  </Section>

  <Section tone="surface" class="!py-4 sticky top-0 z-20 border-b border-border/70">
    <div class="flex flex-wrap gap-3" data-reveal>
      {programAreas.map((area) => (
        <a href={`#${area.slug}`} class="rounded-full border border-border bg-white px-4 py-2 text-sm font-semibold text-ink-600 hover:border-accent-500 hover:text-accent-600 transition-colors">
          {area.label}
        </a>
      ))}
    </div>
  </Section>

  <Section tone="white" id="all-programs">
    <div class="space-y-16">
      {programsByArea.map((area) => (
        <div id={area.slug} class="scroll-mt-24">
          <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">
                {area.label}
              </p>
              <h3 class="mt-2 text-2xl font-bold text-ink-900">{area.label}</h3>
            </div>
            <p class="max-w-xl text-sm text-ink-500">
              {area.description}
            </p>
          </div>

          {area.programs.length > 0 ? (
            <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
              {area.programs.map((program) => (
                <ProgramCard slug={program.id} data={program.data} />
              ))}
            </div>
          ) : (
            <div class="mt-8 rounded-3xl border border-dashed border-border bg-surface-50 p-8 text-sm text-ink-500">
              More programs in this area are being added soon. Book a counselling call to explore the best fit.
            </div>
          )}
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>

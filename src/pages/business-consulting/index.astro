---
/**
 * /business-consulting/ — DAIT Business Consulting.
 *
 * The B2B vertical: founder-led growth consulting, sales enablement and
 * corporate training for manufacturing, industrial, IT/SaaS and service
 * businesses. Built on the existing design system (Section, SectionLabel,
 * Button, Section) so it reads as part of the site, with a darker,
 * quieter treatment so it reads as enterprise rather than campus.
 *
 * All copy and figures come from src/data/consulting.ts — edit claims there.
 *
 * POSITIONING: advisory, training and coaching. NOT an agency, not lead gen,
 * not campaign execution, not implementation. The boundary lines on the
 * service cards and in the process section are load-bearing, not decoration.
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import type { WithContext, ProfessionalService } from "schema-dts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/ui/Section.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Button from "../../components/ui/Button.astro";
import CompanyReferences from "../../components/consulting/CompanyReferences.astro";
import ConsultingForm from "../../components/forms/ConsultingForm.tsx";
import { siteConfig } from "../../config/site";
import { canonicalUrl } from "../../lib/seo";
import { localAreaServed } from "../../data/seo-defaults";
import {
  consultingStats,
  statsDisclaimer,
  serviceCategories,
  consultingIndustries,
  consultingProcess,
  processBoundary,
  partnerCategories,
  founderConsulting as f,
} from "../../data/consulting";

const centre = siteConfig.centers[0];
const url = canonicalUrl("/business-consulting/");

/**
 * Technology services come from the content collection, because each one has
 * its own landing page at /business-consulting/<slug>/. Mapped to the same
 * shape as the growth services so one card template renders both; `href` is
 * what makes a card clickable.
 */
const allServices = (await getCollection("consulting"))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({
    title: s.data.title,
    summary: s.data.tagline,
    points: s.data.points,
    icon: s.data.icon,
    boundary: s.data.boundary,
    flagship: s.data.flagship,
    category: s.data.category,
    href: `/business-consulting/${s.id}/`,
  }));

/** Every service now has a page, so every card on this hub routes somewhere. */
const servicesIn = (key: string) => allServices.filter((s) => s.category === key);

/**
 * Counts are derived, never written into the copy.
 *
 * The page used to say "Thirteen services across two practices" in three
 * places. The moment a practice was hidden, the page was advertising services
 * a visitor could not reach — the kind of thing nobody notices until a
 * prospect counts them.
 */
const NUMBER_WORDS = [
  "no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
  "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
  "seventeen", "eighteen", "nineteen", "twenty",
];
const inWords = (n: number) => NUMBER_WORDS[n] ?? String(n);

const serviceCount = allServices.length;
const livePractices = serviceCategories.filter((c) => servicesIn(c.key).length > 0);

/**
 * Whether the technology practice is actually reachable right now.
 *
 * Derived from the content rather than read from a flag, so the headline, the
 * meta and the schema can never promise AI, cloud or SAP advisory while those
 * pages are drafts. Restoring the practice restores the copy with it.
 */
const hasTechnology = servicesIn("technology").length > 0;

/**
 * ProfessionalService rather than a second Organization — the site already
 * emits an EducationalOrganization from BaseLayout, and declaring two competing
 * organisation entities for one domain muddies the knowledge graph. This is
 * scoped to the service and points back at the existing org via `provider`.
 */
const schema: WithContext<ProfessionalService> = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${url}#service`,
  name: "DAIT Business Consulting",
  url,
  description: hasTechnology
    ? "Independent business and technology advisory for midsize and enterprise companies: B2B growth strategy and sales enablement, plus consulting across AI, data, cloud, SAP and application modernisation."
    : "Independent B2B growth advisory for midsize and enterprise companies: go-to-market strategy, demand generation, sales enablement, vendor selection and corporate training.",
  parentOrganization: { "@id": `${siteConfig.url}/#organization` },
  areaServed: localAreaServed(),
  address: {
    "@type": "PostalAddress",
    addressLocality: centre.city,
    addressRegion: centre.state,
    addressCountry: "IN",
    ...(centre.postalCode ? { postalCode: centre.postalCode } : {}),
  },
  ...(siteConfig.phone ? { telephone: siteConfig.phone } : {}),
  email: siteConfig.email,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Consulting services",
    /* Each offer points at its own page via url, so the catalogue links to
       the Service entities those pages declare rather than restating them. */
    itemListElement: allServices.map((svc) => ({
      "@type": "Offer" as const,
      itemOffered: {
        "@type": "Service" as const,
        name: svc.title,
        description: svc.summary,
        url: canonicalUrl(svc.href),
      },
    })),
  },
};
---

<BaseLayout
  title={
    hasTechnology
      ? "Business & Technology Consulting for B2B Companies | DAIT"
      : "B2B Growth Consulting & Corporate Training | DAIT"
  }
  brandedTitle={false}
  description={
    hasTechnology
      ? "Independent advisory for midsize and enterprise: B2B growth and sales strategy, plus technology consulting across AI, data, cloud, SAP and app modernisation."
      : "Independent B2B growth advisory for midsize and enterprise: go-to-market strategy, demand generation and ABM, sales enablement, vendor selection and corporate training."
  }
  canonicalPath="/business-consulting/"
  keywords={[
    "business and technology consulting India",
    "B2B growth consultant Chhatrapati Sambhajinagar",
    "business consulting Sambhaji Nagar",
    "B2B marketing consultant Maharashtra",
    "manufacturing marketing consultant",
    "account-based marketing consultant",
    "fractional CMO services",
    "AI consulting India",
    "digital transformation consulting",
    "cloud and DevOps consulting",
    "SAP advisory India",
    "technology vendor advisory",
  ]}
  ogImage={f.photo}
  jsonLd={[schema]}
>
  {/* ── 1 · Hero (DARK) ─────────────────────────────────────
      Deliberately NOT founder-led. This hub covers two practices now, and a
      hero built around one person's marketing CV told half the story — a
      buyer arriving from an SAP or cloud search found nothing addressed to
      them. The founder's credibility still matters, so it moved down to its
      own section with the track record beside it, where proof belongs. */}
  <Section tone="dark" class="pt-28 pb-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
        <div data-reveal>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-[0.7rem] font-bold uppercase tracking-wider text-white"
          >
            <Icon name="lucide:briefcase-business" size={14} class="text-orange-400" />
            Independent advisory · Midsize &amp; enterprise · India
          </p>

          <h1
            class="mt-6 text-[2rem] font-black leading-[1.08] tracking-tight text-white sm:text-[2.6rem] lg:text-5xl"
          >
            {hasTechnology ? "Growth and technology advice" : "B2B growth advice"} from a firm
            that <span class="text-orange-400">implements nothing</span>
          </h1>

          <p class="mt-5 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
            {inWords(serviceCount).charAt(0).toUpperCase() + inWords(serviceCount).slice(1)}{" "}
            services across {inWords(livePractices.length)}{" "}
            {livePractices.length === 1 ? "practice" : "practices"}, on how you win customers and
            what you build, buy or modernise. We take no implementation revenue and no vendor
            commission — which is what lets the answer be that you should keep what you have, or
            do nothing at all.
          </p>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/70">
            Every engagement ends with a decision you can defend and a team that can run it. Your
            people, or the partner you appoint, do the execution.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="#consultation" size="lg">Book a business consultation</Button>
            <Button href="#services" variant="ghost-on-dark" icon="lucide:arrow-down">
              See all {inWords(serviceCount)} services
            </Button>
          </div>
        </div>

        {/* The two practices, in place of the founder portrait that used to
            sit here. A buyer who arrived searching for SAP or cloud advisory
            can now see in the hero that it exists. */}
        <div class="w-full space-y-4" data-reveal data-reveal-delay="0.1">
          {serviceCategories.map((cat) => {
            const inCat = servicesIn(cat.key);
            return inCat.length === 0 ? null : (
              <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-5">
                <p class="flex items-baseline justify-between gap-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-orange-400">
                    {cat.label}
                  </span>
                  <span class="shrink-0 text-xs font-semibold text-white/50">
                    {inCat.length} services
                  </span>
                </p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {inCat.map((s) => (
                    <li>
                      <a
                        href={s.href}
                        class="inline-block rounded-full bg-white/10 px-2.5 py-1 text-[0.72rem] font-semibold text-white/85 transition-colors hover:bg-white/20 hover:text-white"
                      >
                        {s.title.replace(" Consulting", "")}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
    </div>
  </Section>

  <!-- ── 2 · Services (LIGHT) ─────────────────────────────── -->
  <Section tone="white" id="services">
    <div class="max-w-2xl" data-reveal>
      <SectionLabel>What we do</SectionLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
        {inWords(serviceCount).charAt(0).toUpperCase() + inWords(serviceCount).slice(1)} services,{" "}
        <span class="text-orange-500">{inWords(livePractices.length)} {livePractices.length === 1 ? "practice" : "practices"}</span>
      </h2>
      <p class="mt-4 text-ink-500 measure">
        Growth work on how you win customers, and technology advisory on what to build, buy or
        modernise. Every service states where we stop: we advise your team and build their
        capability, and your team — or a vendor you choose — does the execution. That boundary
        is deliberate, and it is what keeps the advice honest.
      </p>
    </div>

    {/* Grouped by practice. Thirteen services in one grid is a wall, and the
        split also makes the two propositions legible: growth work the founder
        delivers, and technology advisory where a partner implements. */}
    {serviceCategories.map((cat) => {
      /* All thirteen services live in the content collection now, each with
         its own landing page — so this hub is a directory and every card
         routes onward, which is the whole point of it. */
      const inCat = servicesIn(cat.key);
      return inCat.length === 0 ? null : (
        <div class="mt-14 first:mt-10">
          <div class="max-w-3xl" data-reveal>
            <h3 class="text-2xl font-black text-ink-900">{cat.label}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500 measure">{cat.blurb}</p>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        inCat.map((s, i) => (
          <article
            class={`flex flex-col rounded-3xl border p-7 shadow-sm ${
              s.flagship
                ? "border-orange-300 bg-orange-50/40 md:col-span-2"
                : "border-border bg-white"
            }`}
            data-reveal
            data-reveal-delay={(i * 0.05).toString()}
          >
            <div class="flex items-start gap-4">
              <span
                class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl ${
                  s.flagship ? "bg-orange-500 text-white" : "bg-accent-50 text-accent-600"
                }`}
              >
                <Icon name={s.icon} size={24} />
              </span>
              <div class="min-w-0">
                {s.flagship && (
                  <span class="inline-block rounded-full bg-orange-500 px-2.5 py-0.5 text-[0.65rem] font-bold uppercase tracking-wider text-white">
                    Flagship
                  </span>
                )}
                <h3 class={`text-xl font-bold text-ink-900 ${s.flagship ? "mt-2" : ""}`}>
                  {/* Services with their own page link from the heading, so the
                      whole title is the target rather than a "read more" tacked
                      on underneath. */}
                  {"href" in s && s.href ? (
                    <a
                      href={s.href}
                      class="transition-colors hover:text-accent-500 focus-visible:text-accent-500"
                    >
                      {s.title}
                    </a>
                  ) : (
                    s.title
                  )}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{s.summary}</p>
              </div>
            </div>

            <ul class={`mt-5 grid gap-2.5 ${s.flagship ? "sm:grid-cols-2" : ""}`}>
              {s.points.map((p) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-ink-600">
                  <Icon
                    name="lucide:check"
                    size={16}
                    class={`mt-0.5 shrink-0 ${s.flagship ? "text-orange-500" : "text-accent-500"}`}
                  />
                  <span>{p}</span>
                </li>
              ))}
            </ul>

            {s.boundary && (
              <p class="mt-5 flex gap-2 rounded-xl bg-surface-50 p-3 text-xs leading-relaxed text-ink-500">
                <Icon name="lucide:info" size={14} class="mt-0.5 shrink-0 text-ink-400" />
                <span>{s.boundary}</span>
              </p>
            )}

            {"href" in s && s.href && (
              <a
                href={s.href}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-accent-500 transition-colors hover:text-accent-600"
              >
                {`How ${s.title.replace(" Consulting", "")} engagements work`}
                <Icon name="lucide:arrow-right" size={16} />
              </a>
            )}
          </article>
        ))
      }
          </div>
        </div>
      );
    })}

    <div class="mt-10" data-reveal>
      <Button href="#consultation" variant="outline" icon="lucide:arrow-right">
        Request a growth assessment
      </Button>
    </div>
  </Section>

  <!-- ── 3 · Industries (LIGHT) ───────────────────────────── -->
  <Section tone="surface">
    <div class="max-w-2xl" data-reveal>
      <SectionLabel>Where we work</SectionLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
        Industries, and the problems <span class="text-orange-500">they share</span>
      </h2>
      {/* This used to read "commercial, not technical — not engineering your
          product", which was honest when the page only sold growth work and
          flatly contradicts the technology practice. The real boundary is
          advisory versus delivery, and it holds for both. */}
      <p class="mt-4 text-ink-500 measure">
        Experience across these sectors is commercial and advisory: how you reach and convince
        buyers, and how you decide what to build, buy or modernise. Not engineering your product
        or implementing your systems — that stays with your team or the partner you appoint.
      </p>
    </div>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        consultingIndustries.map((ind, i) => (
          <li
            class="rounded-2xl border border-border bg-white p-6 shadow-sm"
            data-reveal
            data-reveal-delay={(i * 0.05).toString()}
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
              <Icon name={ind.icon} size={21} />
            </span>
            <h3 class="mt-4 text-base font-bold leading-snug text-ink-900">{ind.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{ind.challenge}</p>
          </li>
        ))
      }
    </ul>

    {/* Renders only once an approved, permissioned name is added. */}
    <div class="mt-10">
      <CompanyReferences
        heading="Named references"
        intro="Published with written permission. Relationship stated exactly."
      />
    </div>
  </Section>

  <!-- ── 4 · How we work (DARK) ───────────────────────────── -->
  <Section tone="dark">
    <div class="max-w-2xl" data-reveal>
      <SectionLabel onDark>How we work</SectionLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl text-white">
        Five stages, and your team <span class="text-orange-400">keeps the wheel</span>
      </h2>
      <p class="mt-4 text-white/70 measure">{processBoundary}</p>
    </div>

    <div class="relative mt-12">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-[1.375rem] hidden h-px bg-white/15 lg:block"
      >
      </div>
      <ol class="relative grid gap-8 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-5 lg:gap-6">
        {
          consultingProcess.map((stage, i) => (
            <li
              class="relative flex gap-4 lg:block"
              data-reveal
              data-reveal-delay={(i * 0.08).toString()}
            >
              {i < consultingProcess.length - 1 && (
                <span
                  aria-hidden="true"
                  class="absolute left-[1.375rem] top-12 -bottom-8 w-px bg-white/15 sm:hidden"
                />
              )}
              <span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-orange-500 text-sm font-black text-white ring-4 ring-dark-950">
                {i + 1}
              </span>
              <div class="min-w-0 lg:mt-5">
                <p class="text-sm font-black uppercase tracking-wider text-white">{stage.title}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-white/65">{stage.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- ── 5 · About the founder (LIGHT) ────────────────────── -->
  <Section tone="white" id="founder">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14 lg:items-start">
      <div class="relative mx-auto w-full max-w-sm lg:mx-0" data-reveal>
        <img
          src={f.photo}
          alt={`${f.name} — founder, DAIT Business Consulting`}
          width="1080"
          height="1080"
          loading="lazy"
          class="aspect-[4/5] w-full rounded-3xl object-cover shadow-lg"
        />
      </div>

      <div data-reveal data-reveal-delay="0.1">
        <SectionLabel>About the founder</SectionLabel>
        <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
          Growth strategy backed by <span class="text-orange-500">real-world B2B experience</span>
        </h2>
        <p class="mt-4 text-sm font-semibold text-accent-600">{f.positioning}</p>

        <div class="mt-5 space-y-4 measure text-ink-600">
          {f.bio.map((p) => <p class="text-sm leading-relaxed">{p}</p>)}
        </div>

        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          {
            f.credentials.map((c) => (
              <div class="rounded-2xl border border-border bg-surface-50 p-4">
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
                    <Icon name={c.icon} size={19} />
                  </span>
                  <div class="min-w-0">
                    <p class="font-extrabold leading-tight text-ink-900">{c.value}</p>
                    <p class="text-xs leading-snug text-ink-500">{c.label}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="mt-8">
          <Button href="#consultation" icon="lucide:arrow-right">
            Discuss a consulting engagement
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <!-- ── Track record (LIGHT) — sits with the founder, because these
       are his figures rather than the practice's headline ─────── -->
  <Section tone="surface" class="!py-10 lg:!py-12">
    <dl class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        consultingStats.map((s, i) => (
          <div
            class="rounded-2xl border border-border bg-white p-5 shadow-sm"
            data-reveal
            data-reveal-delay={(i * 0.06).toString()}
          >
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="block text-3xl font-black leading-none text-ink-900">{s.value}</span>
              <span class="mt-2 block text-sm font-semibold leading-snug text-ink-600">
                {s.label}
              </span>
              {s.note && (
                <span class="mt-1.5 block text-xs leading-snug text-orange-600">{s.note}</span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 max-w-3xl text-xs leading-relaxed text-ink-500">{statsDisclaimer}</p>
  </Section>

  <!-- ── 6 · Technology partner network (WHITE) ───────────── -->
  <Section tone="white" id="partners">
    <div class="max-w-2xl" data-reveal>
      <SectionLabel>Partner network</SectionLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl text-ink-900">
        The right expertise. The right <span class="text-orange-500">technology partner</span>.
      </h2>
      <p class="mt-4 text-ink-500 measure">
        When a project needs building rather than advising, we help you define what you actually
        need and identify specialist providers who can deliver it. DAIT does not implement — and
        any referral arrangement is set out in writing and disclosed to you.
      </p>
    </div>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        partnerCategories.map((c, i) => (
          <li
            class="rounded-2xl border border-border bg-white p-6 shadow-sm"
            data-reveal
            data-reveal-delay={(i * 0.05).toString()}
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
              <Icon name={c.icon} size={21} />
            </span>
            <h3 class="mt-4 text-base font-bold text-ink-900">{c.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{c.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 grid gap-6 lg:grid-cols-2" data-reveal>
      <div class="rounded-3xl border border-border bg-white p-7 shadow-sm">
        <h3 class="text-lg font-bold text-ink-900">I need a technology partner</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-500">
          Tell us what you are trying to achieve. We will help define the requirement and point you
          to providers worth evaluating.
        </p>
        <div class="mt-5">
          <Button href="#consultation" variant="outline" icon="lucide:arrow-right">
            Start with a consultation
          </Button>
        </div>
      </div>

      <div class="rounded-3xl border border-border bg-white p-7 shadow-sm">
        <h3 class="text-lg font-bold text-ink-900">I want to become a DAIT partner</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-500">
          If you deliver implementation work in one of the categories above, tell us about your
          capability.
        </p>
        <div class="mt-5">
          <ConsultingForm client:visible variant="partner" />
        </div>
      </div>
    </div>
  </Section>

  <!-- ── 7 · Consultation form (DARK) ─────────────────────── -->
  <Section tone="dark" id="consultation">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div data-reveal>
        <SectionLabel onDark>Book a consultation</SectionLabel>
        <h2 class="mt-3 text-3xl sm:text-4xl text-white">
          Start with a conversation, <span class="text-orange-400">not a proposal</span>
        </h2>
        <p class="mt-4 text-white/70 measure">
          Tell us where the growth problem actually sits. The first conversation is about
          understanding your business — if consulting is not what you need, we will say so.
        </p>

        <ul class="mt-7 space-y-3">
          {
            [
              "Founder-led — you talk to Amol, not an account manager",
              "In person in " + centre.city + ", or online",
              "No obligation, and no pressure to commit",
            ].map((point) => (

---
/**
 * Homepage — alternating dark/light rhythm (see BRAND.md).
 * 1 Hero (D) · 2 Choose your path (L) · 3 Which describes you (L)
 * 4 DAIT Difference (L) · 5 Learning Model (D) · 6 Legacy (L)
 * 7 Founder story (D) · 8 Featured programs (L) · 9 Upcoming batches (L)
 * 10 Blog (L) · 11 Final CTA (L) · Footer (D)
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
import Button from "../components/ui/Button.astro";
import Hero from "../components/sections/Hero.astro";
import PathSelector from "../components/sections/PathSelector.astro";
import LegacyGroup from "../components/sections/LegacyGroup.astro";
import FounderStory from "../components/sections/FounderStory.astro";
import AudienceSplit from "../components/sections/AudienceSplit.astro";
import DaitDifference from "../components/sections/DaitDifference.astro";
import LearningModel from "../components/sections/LearningModel.astro";
import ProgramCard from "../components/sections/ProgramCard.astro";
import CTABanner from "../components/sections/CTABanner.astro";
import { siteConfig } from "../config/site";
import { primaryCta } from "../data/navigation";

// Programs collection (empty until Phase 2 — everything degrades gracefully).
const allPrograms = (await getCollection("programs")).filter(
  (p) => !p.data.draft,
);
const featured = allPrograms
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Batch start dates are hidden site-wide via siteConfig.display — see
// config/site.ts. With none listed, the section below renders its
// "New batch dates are announced regularly" card plus a register-interest CTA.
const upcoming = (siteConfig.display.showNextBatchDate ? allPrograms : [])
  .filter((p) => p.data.nextBatchDate)
  .sort(
    (a, b) =>
      new Date(a.data.nextBatchDate!).getTime() -
      new Date(b.data.nextBatchDate!).getTime(),
  )
  .slice(0, 5);

const latestPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
  )
  .slice(0, 3);
const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("en-IN", { day: "numeric", month: "short", year: "numeric" }).format(new Date(d));
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  brandedTitle={false}
  description={siteConfig.description}
  canonicalPath="/"
>
  <!-- ── 1 · Hero (statement) ─────────────────────────────── -->
  <Hero />

  <!-- ── 2 · Choose your path (3 audiences) ───────────────── -->
  <Section tone="surface">
    <PathSelector />
  </Section>

  <!-- ── 3 · Which describes you? (LIGHT) — graduate vs professional ─── -->
  <Section tone="white">
    <AudienceSplit />
  </Section>

  <!-- ── 4 · The DAIT Difference (LIGHT) — six pillars ────── -->
  <Section tone="surface">
    <DaitDifference />
  </Section>

  <!-- ── 5 · The DAIT Learning Model (DARK) ───────────────── -->
  <Section tone="dark">
    <LearningModel />
  </Section>

  <!-- ── 6 · Legacy · Dhakne Education Group (LIGHT) ──────── -->
  <Section tone="white">
    <LegacyGroup variant="full" />
    <div class="mt-8" data-reveal>
      <Button href="/why-dait/" variant="outline" size="sm" icon="lucide:arrow-right">
        Meet the family behind DAIT
      </Button>
    </div>
  </Section>

  <!-- ── 7 · Why DAIT / Founder story (DARK) ──────────────── -->
  <Section tone="dark">
    <FounderStory />
  </Section>

  <!-- ── 8 · Featured programs (LIGHT) ────────────────────── -->
  <Section tone="white">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div class="max-w-2xl">
        <SectionLabel>Flagship programs</SectionLabel>
        <h2 class="mt-3 text-3xl sm:text-4xl">Where to <span class="text-orange-500">begin</span></h2>
      </div>
      <Button href="/programs/" variant="outline" size="sm" icon="lucide:arrow-right">
        View all programs
      </Button>
    </div>

    {
      featured.length > 0 ? (
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featured.map((p) => (
            <ProgramCard slug={p.id} data={p.data} />
          ))}
        </div>
      ) : (
        <div
          class="mt-10 card p-6 sm:p-10 flex flex-col sm:flex-row items-start sm:items-center gap-6"
          data-reveal
        >
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-orange-50 text-orange-600">
            <Icon name="lucide:rocket" size={26} />
          </span>
          <div class="flex-1">
            <h3 class="text-xl text-ink-900">New batches are being scheduled</h3>
            <p class="mt-2 text-sm text-ink-500 measure">
              Full program details and dates are rolling out shortly. Book a free
              counselling call now and we'll match you to the right track and
              reserve your seat.
            </p>
          </div>
          <Button href={primaryCta.href} class="shrink-0">
            {primaryCta.label}
          </Button>
        </div>
      )
    }
  </Section>

  <!-- ── 9 · Upcoming batches (LIGHT) ─────────────────────── -->
  <Section tone="white">
    <div class="max-w-2xl" data-reveal>
      <SectionLabel>Upcoming cohorts</SectionLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl">Plan your <span class="text-orange-500">start</span></h2>
    </div>

    {
      upcoming.length > 0 ? (
        <div class="mt-8 overflow-x-auto" data-reveal>
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead>
              <tr class="border-b border-border text-ink-500">
                <th class="py-3 pr-4 font-bold uppercase tracking-wide text-xs">
                  Program
                </th>
                <th class="py-3 pr-4 font-bold uppercase tracking-wide text-xs">
                  Mode
                </th>
                <th class="py-3 pr-4 font-bold uppercase tracking-wide text-xs">
                  Next batch
                </th>
                <th class="py-3 font-bold uppercase tracking-wide text-xs" />
              </tr>
            </thead>
            <tbody>
              {upcoming.map((p) => (
                <tr class="border-b border-border/70">
                  <td class="py-4 pr-4 font-bold text-ink-900">
                    {p.data.title}
                  </td>
                  <td class="py-4 pr-4 capitalize text-ink-500">
                    {p.data.mode.join(" · ")}
                  </td>
                  <td class="py-4 pr-4 text-ink-600">
                    {new Intl.DateTimeFormat("en-IN", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                    }).format(new Date(p.data.nextBatchDate!))}
                  </td>
                  <td class="py-4">
                    <a
                      href={`/programs/${p.id}/`}
                      class="inline-flex items-center gap-1.5 text-sm font-bold text-accent-600 hover:gap-2.5 transition-all"
                    >
                      Enquire
                      <Icon name="lucide:arrow-right" size={15} />
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div
          class="mt-8 card p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center gap-6"
          data-reveal
        >
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
            <Icon name="lucide:calendar-clock" size={26} />
          </span>
          <div class="flex-1">
            <h3 class="text-xl text-ink-900">
              New batch dates are announced regularly
            </h3>
            <p class="mt-2 text-sm text-ink-500 measure">
              Weekday full-time and weekend/evening batches run through the year.
              Register your interest and we'll tell you the moment the next batch
              for your track opens.
            </p>
          </div>
          <Button href={primaryCta.href} variant="outline" class="shrink-0">
            Register interest
          </Button>
        </div>
      )
    }
  </Section>

  <!-- ── 10 · Latest from the blog (LIGHT) ────────────────── -->
  {
    latestPosts.length > 0 && (
      <Section tone="surface">
        <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
          <div class="max-w-2xl">
            <SectionLabel>From the blog</SectionLabel>
            <h2 class="mt-3 text-3xl sm:text-4xl">Career guides & <span class="text-orange-500">AI skills</span></h2>
          </div>
          <Button href="/blog/" variant="outline" size="sm" icon="lucide:arrow-right">
            View all articles
          </Button>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {latestPosts.map((post, i) => (
            <a href={`/blog/${post.id}/`} class="card card--hover group flex flex-col p-6" data-reveal data-reveal-delay={(i * 0.06).toString()}>
              <div class="flex items-center gap-3 text-xs">
                <span class="rounded-full bg-accent-50 px-2.5 py-1 font-bold text-accent-600">{post.data.category}</span>
                <span class="text-ink-400">{post.data.readMinutes} min read</span>
              </div>
              <h3 class="mt-4 text-lg font-bold text-ink-900 transition-colors group-hover:text-accent-600">{post.data.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{post.data.description}</p>
              <span class="mt-5 text-xs text-ink-400">{fmtDate(post.data.publishDate)}</span>
            </a>
          ))}
        </div>
      </Section>
    )
  }

  <!-- ── 11 · Final CTA (LIGHT bg, blue banner) ───────────── -->
  <Section tone="surface">
    <CTABanner />
  </Section>
</BaseLayout>
